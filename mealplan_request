@app.get("/workflows")
async def get_workflows():
    """Get available workflow types and their definitions"""
    workflows = {}
    for workflow_type in meal_planning_orchestrator.get_supported_workflows():
        workflows[workflow_type] = meal_planning_orchestrator.get_workflow_definition(workflow_type)
    
    return {
        "available_workflows": workflows,
        "default_workflow": "full_meal_plan"
    }

@app.post("/meal-plan/generate")
async def generate_meal_plan(
    request: MealPlanRequest,
    background_tasks: BackgroundTasks
):
    """Generate a new meal plan for a user"""
    try:
        system_health["total_requests"] += 1
        system_health["active_workflows"] += 1
        
        logger.info(f"Generating meal plan for user {request.user_id}")
        
        # Prepare request data
        request_data = {
            "plan_days": request.plan_days,
            "preferences": request.preferences
        }
        
        if request.dietary_requirements:
            request_data["dietary_requirements"] = request.dietary_requirements
        
        if request.cooking_constraints:
            request_data["cooking_constraints"] = request.cooking_constraints
        
        if request.inventory_update:
            request_data["inventory_update"] = request.inventory_update
        
        # Execute workflow
        result = await meal_planning_orchestrator.execute_meal_planning_workflow(
            user_id=request.user_id,
            request_data=request_data,
            workflow_type="full_meal_plan"
        )
        
        system_health["active_workflows"] -= 1
        
        if result["status"] == WorkflowStatus.FAILED.value:
            raise HTTPException(status_code=500, detail=result.get("error", "Meal planning failed"))
        
        # Schedule background tasks for analytics
        background_tasks.add_task(log_meal_plan_generation, request.user_id, result)
        
        return {
            "success": True,
            "workflow_id": result["workflow_id"],
            "status": result["status"],
            "meal_plan": result.get("meal_plan"),
            "shopping_list": result.get("shopping_list"),
            "nutrition_analysis": result.get("nutrition_analysis"),
            "execution_time": result.get("execution_time"),
            "metadata": result.get("metadata", {})
        }
        
    except HTTPException:
        raise
    except Exception as e:
        system_health["active_workflows"] -= 1
        logger.error(f"Error generating meal plan: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Internal server error: {str(e)}")


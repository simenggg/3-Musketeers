# Pydantic models for API requests
class MealPlanRequest(BaseModel):
    user_id: str
    plan_days: int = Field(default=7, ge=1, le=14)
    preferences: Dict[str, Any] = Field(default_factory=dict)
    dietary_requirements: Optional[Dict[str, Any]] = None
    cooking_constraints: Optional[Dict[str, Any]] = None
    inventory_update: Optional[Dict[str, Any]] = None

class FeedbackRequest(BaseModel):
    user_id: str
    meal_plan_id: Optional[str] = None
    feedback_type: str = Field(..., regex="^(rating|preference|complaint|suggestion)$")
    feedback_data: Dict[str, Any]
    source: str = "api"

class InventoryUpdateRequest(BaseModel):
    user_id: str
    inventory_data: Dict[str, Any]
    update_type: str = Field(default="full", regex="^(full|partial|add|remove)$")

class QuickRecipeRequest(BaseModel):
    user_id: str
    recipe_criteria: Dict[str, Any]
    available_ingredients: Optional[list] = None


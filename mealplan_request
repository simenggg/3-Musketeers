# Global state for system health
system_health = {
    "status": "initializing",
    "last_health_check": None,
    "active_workflows": 0,
    "total_requests": 0
}

@app.on_event("startup")
async def startup_event():
    """Initialize system on startup"""
    try:
        logger.info("Starting Good Food to You meal planning system...")
        
        # Load configuration
        config = load_config()
        
        # Initialize database connection
        await db.initialize()
        
        # Health check on orchestrator
        workflows = meal_planning_orchestrator.get_supported_workflows()
        logger.info(f"Loaded {len(workflows)} workflow types: {workflows}")
        
        system_health["status"] = "healthy"
        system_health["last_health_check"] = datetime.utcnow().isoformat()
        
        logger.info("System startup completed successfully")
        
    except Exception as e:
        logger.error(f"System startup failed: {str(e)}")
        system_health["status"] = "unhealthy"
        raise

@app.on_event("shutdown")
async def shutdown_event():
    """Cleanup on shutdown"""
    logger.info("Shutting down meal planning system...")
    await db.close()
    logger.info("System shutdown completed")


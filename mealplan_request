# CLI Interface
class CLIHandler:
    """Command-line interface handler"""
    
    def __init__(self):
        self.orchestrator = meal_planning_orchestrator
    
    async def handle_meal_plan_command(self, args):
        """Handle meal plan generation from CLI"""
        print(f"Generating meal plan for user: {args.user_id}")
        
        request_data = {
            "plan_days": args.days,
            "preferences": json.loads(args.preferences) if args.preferences else {}
        }
        
        result = await self.orchestrator.execute_meal_planning_workflow(
            user_id=args.user_id,
            request_data=request_data,
            workflow_type="full_meal_plan"
        )
        
        self._print_result(result)
    
    async def handle_recipe_command(self, args):
        """Handle recipe generation from CLI"""
        print(f"Generating recipe for user: {args.user_id}")
        
        request_data = {
            "recipe_request": json.loads(args.criteria) if args.criteria else {}
        }
        
        result = await self.orchestrator.execute_meal_planning_workflow(
            user_id=args.user_id,
            request_data=request_data,
            workflow_type="quick_recipe"
        )
        
        self._print_result(result)
    
    def _print_result(self, result):
        """Pretty print CLI results"""
        print("\n" + "="*60)
        print(f"Workflow ID: {result.get('workflow_id')}")
        print(f"Status: {result.get('status')}")
        print(f"Execution Time: {result.get('execution_time', 0):.2f}s")
        
        if result.get("meal_plan"):
            print("\nMeal Plan Generated:")
            meal_plan = result["meal_plan"]
            for meal in meal_plan.get("meals", []):
                print(f"  Day {meal.get('day')}: {meal.get('meal_type')} - {meal.get('recipe', {}).get('name')}")
        
        if result.get("shopping_list"):
            print("\nShopping List:")
            for item in result["shopping_list"][:5]:  # Show first 5 items
                print(f"  - {item}")
        
        print("="*60)

def create_cli_parser():
    """Create command-line argument parser"""
    parser = argparse.ArgumentParser(
        description="Good Food to You - AI Meal Planning System",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Available commands')
    
    # Server command
    server_parser = subparsers.add_parser('server', help='Start the API server')
    server_parser.add_argument('--host', default='127.0.0.1', help='Host to bind to')
    server_parser.add_argument('--port', type=int, default=8000, help='Port to bind to')
    server_parser.add_argument('--reload', action='store_true', help='Enable auto-reload')
    
    # Meal plan command
    meal_parser = subparsers.add_parser('meal-plan', help='Generate a meal plan')
    meal_parser.add_argument('user_id', help='User ID')
    meal_parser.add_argument('--days', type=int, default=7, help='Number of days for the plan')
    meal_parser.add_argument('--preferences', help='Preferences as JSON string')
    
    # Recipe command
    recipe_parser = subparsers.add_parser('recipe', help='Generate a quick recipe')
    recipe_parser.add_argument('user_id', help='User ID')
    recipe_parser.add_argument('--criteria', help='Recipe criteria as JSON string')
    
    # Health check command
    subparsers.add_parser('health', help='Check system health')
    
    # List workflows command
    subparsers.add_parser('workflows', help='List available workflows')
    
    return parser

async def main():
    """Main entry point"""
    parser = create_cli_parser()
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    try:
        if args.command == 'server':
            # Start FastAPI server
            print(f"Starting Good Food to You API server on {args.host}:{args.port}")
            uvicorn.run(
                "main:app",
                host=args.host,
                port=args.port,
                reload=args.reload,
                log_level="info"
            )
        
        elif args.command == 'health':
            # Simple health check
            workflows = meal_planning_orchestrator.get_supported_workflows()
            print(f"System Status: Healthy")
            print(f"Available Workflows: {len(workflows)}")
            print(f"Workflows: {', '.join(workflows)}")
        
        elif args.command == 'workflows':
            # List workflows
            workflows = meal_planning_orchestrator.get_supported_workflows()
            print("Available Workflows:")
            for workflow in workflows:
                definition = meal_planning_orchestrator.get_workflow_definition(workflow)
                print(f"\n{workflow}:")
                for step in definition:
                    print(f"  - {step['agent_type']} (priority: {step['priority']})")
        
        elif args.command in ['meal-plan', 'recipe']:
            # Initialize system for CLI operations
            await db.initialize()
            
            cli = CLIHandler()
            
            if args.command == 'meal-plan':
                await cli.handle_meal_plan_command(args)
            elif args.command == 'recipe':
                await cli.handle_recipe_command(args)
            
            await db.close()
        
        else:
            parser.print_help()
    
    except KeyboardInterrupt:
        print("\nOperation cancelled by user")
    except Exception as e:
        logger.error(f"Error in main: {str(e)}")
        print(f"Error: {str(e)}")
        sys.exit(1)

if __name__ == "__main__":
    asyncio.run(main())